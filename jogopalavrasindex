<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jogo de Adivinhação</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <main class="jogo">
        <header>
            <h1>Adivinhe a Palavra</h1>
            <p class="dica">Dica: <span id="dica-texto"></span></p>
        </header>

        <section class="painel-palavra">
            <p id="palavra" aria-live="polite">_ _ _ _ _</p>
        </section>

        <section class="status">
            <p>Tentativas restantes: <strong id="tentativas">6</strong></p>
            <p class="placar">Partidas: <span id="partidas">0</span> | Vitórias: <span id="vitorias">0</span> | Derrotas: <span id="derrotas">0</span></p>
        </section>

        <section class="controles">
            <label for="letra">Digite uma letra:</label>
            <div class="input-grupo">
                <input id="letra" type="text" maxlength="1" autocomplete="off" autofocus>
                <button id="btn-tentar" type="button">Tentar</button>
            </div>
        </section>

        <p id="mensagem" class="mensagem" aria-live="polite"></p>

        <section class="historico">
            <p>Letras utilizadas: <span id="letras-usadas">Nenhuma</span></p>
        </section>

        <footer>
            <button id="btn-reiniciar" type="button">Nova partida</button>
        </footer>
    </main>

    <script src="script.js"></script>
</body>
</html>
